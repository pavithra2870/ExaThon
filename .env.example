# Copy to .env and fill in the credentials configured for your local Exasol container.
# DSN format: host/<TLS certificate SHA-256 fingerprint>:port
# Pinning the fingerprint keeps TLS verification on for a self-signed local server.
EXA_DSN=localhost/<FINGERPRINT>:9563
EXA_USER=sys
EXA_PASSWORD=
EXA_SCHEMA=PROMOLENS
